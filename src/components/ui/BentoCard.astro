---
interface Props {
  id: string;
  tag: string;
  title: string;
  description: string;
  variant: 'wide' | 'standard' | 'lead';
  accent: 'violet' | 'mint' | 'coral' | 'gold' | 'rose';
  index: number;
  revealDelay?: number;
}
const { id, tag, title, description, variant, accent, index, revealDelay } = Astro.props;

const markMap: Record<string, string> = {
  tech:    '/assets/bento-tech.svg',
  nature:  '/assets/bento-nature.svg',
  neuro:   '/assets/bento-neuro.svg',
  agency:  '/assets/bento-agency.svg',
  empathy: '/assets/bento-empathy.svg',
};

const isTech  = id === 'tech';
const isLead  = id === 'agency';
const spanMap = { wide: 'area-card--wide', standard: 'area-card--standard', lead: 'area-card--lead' };
---

<article class:list={[
  'area-card',
  `area-card--${accent}`,
  spanMap[variant],
  isTech && 'area-card--tech-grid',
  isLead && 'area-card--agency-lead',
  'reveal',
  revealDelay && `reveal-delay-${revealDelay}`,
]}>

  <span class="area-card__num" aria-hidden="true">0{index + 1}</span>

  <div class="area-card__tag">{tag}</div>
  <h3 class="area-card__title">{title}</h3>
  <p class="area-card__desc">{description}</p>

  <img
    src={markMap[id]}
    alt=""
    aria-hidden="true"
    class="area-card__mark"
    loading="lazy"
  />

</article>
