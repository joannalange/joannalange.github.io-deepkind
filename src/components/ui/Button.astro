---
/**
 * Button component — renders a styled anchor as a button.
 *
 * Variant names map directly to .btn--{variant} CSS classes in
 * src/styles/components/button.css. Add a new variant there first,
 * then add it to the ButtonVariant union below.
 */
type ButtonVariant = 'primary' | 'ghost-light' | 'ghost-dark' | 'filled-violet' | 'filled-rose';

interface Props {
  label: string;
  href: string;
  variant?: ButtonVariant;
  arrow?: boolean;
}

const { label, href, variant = 'primary', arrow = false } = Astro.props;
---
<a href={href} class={`btn btn--${variant}`}>
  {label}
  {arrow && <span aria-hidden="true">→</span>}
</a>
