<!-- Cookie consent banner — shown only when no choice is stored in localStorage -->
<div
  class="cookie-banner"
  id="cookie-banner"
  hidden
  role="dialog"
  aria-label="Zgoda na pliki cookies"
  aria-live="polite"
>
  <div class="cookie-banner__inner wrap">

    <p class="cookie-banner__text">
      <span data-i18n="cookieBanner.text">Używamy plików cookies, aby zapewnić najlepsze doświadczenie na naszej stronie. Więcej w naszej&nbsp;</span><a
        class="cookie-banner__link"
        href="/polityka-cookies"
        data-i18n="cookieBanner.policyLink"
      >Polityce cookies</a>.
    </p>

    <div class="cookie-banner__actions">
      <button
        id="cookie-accept-all"
        class="cookie-btn cookie-btn--primary"
        data-i18n="cookieBanner.acceptAll"
      >Akceptuj wszystkie</button>
      <button
        id="cookie-necessary"
        class="cookie-btn cookie-btn--secondary"
        data-i18n="cookieBanner.necessary"
      >Tylko niezbędne</button>
    </div>

  </div>
</div>

<script src="@scripts/cookies.ts"></script>
