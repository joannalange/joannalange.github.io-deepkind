---
import content from '@data/content';
const { protocol, status, title, paragraphs } = content.about;
---

<section class="about" id="about" aria-label="O nas">
  <div class="wrap">
    <div class="about__layout">

      <!-- Text -->
      <div class="about__text reveal">

        <div class="about__meta">
          <span class="s-label s-label--dim">{protocol}</span>
          <span class="s-label s-label--gold">{status}</span>
        </div>

        <h2 class="about__headline grad-calm">{title}</h2>

        <div class="about__body">
          {paragraphs.map(p => (
            <p set:html={p} />
          ))}
        </div>

      </div>

      <!-- Photo with floating accent card -->
      <div class="about__photo-wrap reveal reveal-delay-2">
        <img
          src="/img/about-abstract.png"
          alt="Życzliwość tworzy fale"
          class="about__photo"
          loading="lazy"
        />
        <div class="about__accent" aria-hidden="true">
          <span class="about__accent-num">∞</span>
          <span class="about__accent-label">Możliwości</span>
        </div>
      </div>

    </div>
  </div>
</section>
