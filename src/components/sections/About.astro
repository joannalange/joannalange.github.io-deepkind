---
import content from '@data/content';
import aboutSvg from '@assets/svg/about-shape.svg?raw';
const { title, paragraphs } = content.about;
---

<section class="about" id="about" aria-label="O nas">
  <div class="wrap">
    <div class="about__layout">

      <div class="about__text reveal">
        <h2 class="about__headline">{title}</h2>
        <div class="about__body">
          {paragraphs.map(p => <p>{p}</p>)}
        </div>
      </div>

      <div class="about__visual reveal reveal-delay-2" aria-hidden="true">
        <div class="about__shape">
          <Fragment set:html={aboutSvg} />
        </div>
        <div class="about__quote">
          <p>Życzliwość staje się praktyką,<br/>a odpowiedzialność — fundamentem przyszłości.</p>
        </div>
      </div>

    </div>
  </div>
</section>
