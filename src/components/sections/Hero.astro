---
import content from '@data/content';
const { title, subtitle, cta, secondaryCta } = content.hero;

const splitIdx = title.indexOf('. ');
const line1 = splitIdx !== -1 ? title.slice(0, splitIdx + 1) : title;
const line2 = splitIdx !== -1 ? title.slice(splitIdx + 2) : '';
---

<section class="hero" id="home" aria-label="Hero">

  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="hero__glow hero__glow--3"></div>
    <div class="hero__glow hero__glow--4"></div>
  </div>

  <div class="wrap hero__wrap">

    <!-- Left: content -->
    <div class="hero__content animate-fade-up">

      <h1 class="hero__title">
        <span class="hero__line hero__line--1">{line1}</span>
        {line2 && <span class="hero__line hero__line--2">{line2}</span>}
      </h1>

      <p class="hero__subtitle">{subtitle}</p>

      <nav class="hero__ctas" aria-label="Główne akcje">
        <a href="#projects" class="hero__btn hero__btn--primary">{cta}</a>
        <a href={secondaryCta.href} class="hero__btn hero__btn--secondary">{secondaryCta.label}</a>
      </nav>

    </div>

    <!-- Right: illustration -->
    <div class="hero__illustration" aria-hidden="true">
      <svg class="hero__svg" viewBox="0 0 480 520" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Radial gradients for each node -->
          <radialGradient id="g-blue" cx="50%" cy="35%" r="65%">
            <stop offset="0%" stop-color="#3D62ED" stop-opacity="0.55"/>
            <stop offset="100%" stop-color="#3D62ED" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="g-sage" cx="50%" cy="40%" r="65%">
            <stop offset="0%" stop-color="#4BAF82" stop-opacity="0.5"/>
            <stop offset="100%" stop-color="#4BAF82" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="g-lavender" cx="50%" cy="40%" r="65%">
            <stop offset="0%" stop-color="#B87CAE" stop-opacity="0.5"/>
            <stop offset="100%" stop-color="#B87CAE" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="g-peach" cx="50%" cy="35%" r="65%">
            <stop offset="0%" stop-color="#E87A5B" stop-opacity="0.48"/>
            <stop offset="100%" stop-color="#E87A5B" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="g-gold" cx="50%" cy="40%" r="65%">
            <stop offset="0%" stop-color="#D49640" stop-opacity="0.48"/>
            <stop offset="100%" stop-color="#D49640" stop-opacity="0"/>
          </radialGradient>
          <!-- Central glow -->
          <radialGradient id="g-center" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
          </radialGradient>
          <!-- Blur filter for soft glows -->
          <filter id="blur-md">
            <feGaussianBlur stdDeviation="18"/>
          </filter>
          <filter id="blur-sm">
            <feGaussianBlur stdDeviation="6"/>
          </filter>
        </defs>

        <!-- ── Soft background glow blobs ── -->
        <ellipse cx="240" cy="195" rx="160" ry="145" fill="url(#g-blue)" filter="url(#blur-md)"/>
        <ellipse cx="90" cy="145" rx="95" ry="85" fill="url(#g-sage)" filter="url(#blur-md)"/>
        <ellipse cx="395" cy="145" rx="80" ry="72" fill="url(#g-lavender)" filter="url(#blur-md)"/>
        <ellipse cx="375" cy="365" rx="95" ry="85" fill="url(#g-peach)" filter="url(#blur-md)"/>
        <ellipse cx="105" cy="370" rx="88" ry="78" fill="url(#g-gold)" filter="url(#blur-md)"/>

        <!-- ── Connection lines ── -->
        <line x1="240" y1="195" x2="90" y2="130" stroke="#4BAF82" stroke-width="1" stroke-opacity="0.25"/>
        <line x1="240" y1="195" x2="390" y2="135" stroke="#B87CAE" stroke-width="1" stroke-opacity="0.22"/>
        <line x1="240" y1="195" x2="370" y2="360" stroke="#E87A5B" stroke-width="1" stroke-opacity="0.22"/>
        <line x1="240" y1="195" x2="105" y2="360" stroke="#D49640" stroke-width="1" stroke-opacity="0.22"/>
        <line x1="90" y1="130" x2="105" y2="360" stroke="#4BAF82" stroke-width="0.75" stroke-opacity="0.15"/>
        <line x1="390" y1="135" x2="370" y2="360" stroke="#B87CAE" stroke-width="0.75" stroke-opacity="0.15"/>
        <line x1="105" y1="360" x2="370" y2="360" stroke="#ffffff" stroke-width="0.75" stroke-opacity="0.08"/>

        <!-- ── Node: Blue (center — technology) ── -->
        <circle cx="240" cy="195" r="86" fill="#3D62ED" fill-opacity="0.12"/>
        <circle cx="240" cy="195" r="86" stroke="#3D62ED" stroke-width="1.25" stroke-opacity="0.45"/>
        <circle cx="240" cy="195" r="62" stroke="#3D62ED" stroke-width="0.75" stroke-opacity="0.3" stroke-dasharray="3 6"/>
        <circle cx="240" cy="195" r="38" fill="#3D62ED" fill-opacity="0.22"/>
        <circle cx="240" cy="195" r="16" fill="#3D62ED" fill-opacity="0.65"/>
        <circle cx="240" cy="195" r="6" fill="#ffffff" fill-opacity="0.9"/>
        <!-- Inner detail: tick marks -->
        <line x1="240" y1="109" x2="240" y2="100" stroke="#3D62ED" stroke-width="1.5" stroke-opacity="0.7" stroke-linecap="round"/>
        <line x1="240" y1="281" x2="240" y2="290" stroke="#3D62ED" stroke-width="1" stroke-opacity="0.4" stroke-linecap="round"/>
        <line x1="154" y1="195" x2="145" y2="195" stroke="#3D62ED" stroke-width="1" stroke-opacity="0.4" stroke-linecap="round"/>
        <line x1="326" y1="195" x2="335" y2="195" stroke="#3D62ED" stroke-width="1.5" stroke-opacity="0.7" stroke-linecap="round"/>
        <!-- Dot on outer ring -->
        <circle cx="240" cy="109" r="4" fill="#3D62ED" fill-opacity="0.85"/>
        <circle cx="326" cy="195" r="3" fill="#3D62ED" fill-opacity="0.6"/>

        <!-- ── Node: Sage (upper-left — women) ── -->
        <circle cx="90" cy="130" r="56" fill="#4BAF82" fill-opacity="0.12"/>
        <circle cx="90" cy="130" r="56" stroke="#4BAF82" stroke-width="1.25" stroke-opacity="0.45"/>
        <circle cx="90" cy="130" r="36" fill="#4BAF82" fill-opacity="0.2"/>
        <circle cx="90" cy="130" r="14" fill="#4BAF82" fill-opacity="0.6"/>
        <circle cx="90" cy="130" r="5" fill="#ffffff" fill-opacity="0.85"/>
        <circle cx="90" cy="74" r="3.5" fill="#4BAF82" fill-opacity="0.8"/>

        <!-- ── Node: Lavender (upper-right — diversity) ── -->
        <circle cx="390" cy="135" r="50" fill="#B87CAE" fill-opacity="0.12"/>
        <circle cx="390" cy="135" r="50" stroke="#B87CAE" stroke-width="1.25" stroke-opacity="0.45"/>
        <circle cx="390" cy="135" r="32" fill="#B87CAE" fill-opacity="0.2"/>
        <circle cx="390" cy="135" r="13" fill="#B87CAE" fill-opacity="0.6"/>
        <circle cx="390" cy="135" r="5" fill="#ffffff" fill-opacity="0.85"/>
        <circle cx="440" cy="135" r="3" fill="#B87CAE" fill-opacity="0.7"/>

        <!-- ── Node: Peach (lower-right — wellbeing) ── -->
        <circle cx="370" cy="360" r="60" fill="#E87A5B" fill-opacity="0.12"/>
        <circle cx="370" cy="360" r="60" stroke="#E87A5B" stroke-width="1.25" stroke-opacity="0.42"/>
        <circle cx="370" cy="360" r="40" stroke="#E87A5B" stroke-width="0.75" stroke-opacity="0.2" stroke-dasharray="2 5"/>
        <circle cx="370" cy="360" r="22" fill="#E87A5B" fill-opacity="0.22"/>
        <circle cx="370" cy="360" r="10" fill="#E87A5B" fill-opacity="0.65"/>
        <circle cx="370" cy="360" r="4" fill="#ffffff" fill-opacity="0.9"/>
        <circle cx="370" cy="300" r="3.5" fill="#E87A5B" fill-opacity="0.75"/>

        <!-- ── Node: Gold (lower-left — purpose) ── -->
        <circle cx="105" cy="362" r="52" fill="#D49640" fill-opacity="0.12"/>
        <circle cx="105" cy="362" r="52" stroke="#D49640" stroke-width="1.25" stroke-opacity="0.42"/>
        <circle cx="105" cy="362" r="32" fill="#D49640" fill-opacity="0.2"/>
        <circle cx="105" cy="362" r="12" fill="#D49640" fill-opacity="0.6"/>
        <circle cx="105" cy="362" r="4.5" fill="#ffffff" fill-opacity="0.85"/>
        <circle cx="53" cy="362" r="3" fill="#D49640" fill-opacity="0.65"/>

        <!-- ── Central convergence glow ── -->
        <circle cx="240" cy="260" r="30" fill="url(#g-center)" filter="url(#blur-sm)"/>

        <!-- ── Floating particles ── -->
        <circle cx="185" cy="60" r="3" fill="#4BAF82" fill-opacity="0.55"/>
        <circle cx="300" cy="50" r="2" fill="#3D62ED" fill-opacity="0.5"/>
        <circle cx="445" cy="240" r="2.5" fill="#B87CAE" fill-opacity="0.55"/>
        <circle cx="455" cy="290" r="1.5" fill="#E87A5B" fill-opacity="0.5"/>
        <circle cx="35" cy="260" r="2.5" fill="#D49640" fill-opacity="0.55"/>
        <circle cx="42" cy="200" r="1.5" fill="#4BAF82" fill-opacity="0.45"/>
        <circle cx="200" cy="460" r="3" fill="#E87A5B" fill-opacity="0.45"/>
        <circle cx="300" cy="470" r="2" fill="#B87CAE" fill-opacity="0.45"/>
        <circle cx="350" cy="455" r="1.5" fill="#D49640" fill-opacity="0.4"/>

        <!-- ── Small cross decorations ── -->
        <line x1="158" y1="288" x2="168" y2="288" stroke="#ffffff" stroke-width="1" stroke-opacity="0.2"/>
        <line x1="163" y1="283" x2="163" y2="293" stroke="#ffffff" stroke-width="1" stroke-opacity="0.2"/>
        <line x1="330" y1="70" x2="338" y2="70" stroke="#3D62ED" stroke-width="1" stroke-opacity="0.35"/>
        <line x1="334" y1="66" x2="334" y2="74" stroke="#3D62ED" stroke-width="1" stroke-opacity="0.35"/>
        <line x1="60" y1="430" x2="68" y2="430" stroke="#D49640" stroke-width="1" stroke-opacity="0.3"/>
        <line x1="64" y1="426" x2="64" y2="434" stroke="#D49640" stroke-width="1" stroke-opacity="0.3"/>
      </svg>
    </div>

    <div class="hero__scroll-hint" aria-hidden="true">
      <span class="hero__scroll-line"></span>
    </div>

  </div>
</section>
