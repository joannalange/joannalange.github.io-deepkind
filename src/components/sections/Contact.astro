---
import content from '@data/content';
const { heading, description } = content.contact;
const email = content.footer.connect.find(l => l.url.startsWith('mailto:'));
const socials = content.footer.connect.filter(l => !l.url.startsWith('mailto:'));
---

<section class="contact" id="contact" aria-label="Kontakt">
  <div class="wrap">
    <div class="contact__inner reveal">

      <h2 class="contact__heading">{heading}</h2>
      <p class="contact__desc">{description}</p>

      <div class="contact__links">
        {email && (
          <a href={email.url} class="contact__email">
            {email.url.replace('mailto:', '')}
          </a>
        )}
        <div class="contact__socials">
          {socials.map(s => (
            <a
              href={s.url}
              class="contact__social"
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            >{s.name}</a>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
