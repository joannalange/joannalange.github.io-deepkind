---
import ProjectCard from '@ui/ProjectCard.astro';
import ProtocolTag from '@ui/ProtocolTag.astro';
import content from '@data/content.json';
const { header, protocol, items } = content.projects;

const accents = ['amber', 'rose', 'purple', 'cyan'] as const;
---

<section class="projects-section section-padding" id="projects" aria-label="Projekty">
  <div class="site-container">

    <header class="section-header">
      <ProtocolTag label={protocol} color="dim" />
      <h2 class="text-headline gradient-purple-rose">{header}</h2>
    </header>

    <div class="projects-grid">
      {items.map((item, i) => (
        <ProjectCard
          title={item.title}
          category={item.category}
          description={item.description}
          image={item.image}
          cta={item.cta}
          accentColor={accents[i % accents.length]}
        />
      ))}
    </div>

  </div>
</section>
