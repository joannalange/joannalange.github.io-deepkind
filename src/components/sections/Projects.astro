---
import ProjectCard from '@ui/ProjectCard.astro';
import content from '@data/content.json';
const { header, protocol, items } = content.projects;

const gridAccents = ['mint', 'coral', 'gold'] as const;
---

<section class="projects" id="projects" aria-label="Projekty">
  <div class="wrap">

    <header class="projects__header reveal">
      <span class="s-label s-label--dim">{protocol}</span>
      <h2 class="projects__title">{header}</h2>
    </header>

    <!-- Featured first project -->
    <ProjectCard
      title={items[0].title}
      category={items[0].category}
      description={items[0].description}
      image={items[0].image}
      cta={items[0].cta}
      featured={true}
    />

    <!-- Grid: remaining three -->
    <div class="projects__grid">
      {items.slice(1).map((item, i) => (
        <ProjectCard
          title={item.title}
          category={item.category}
          description={item.description}
          image={item.image}
          cta={item.cta}
          accent={gridAccents[i % gridAccents.length]}
        />
      ))}
    </div>

  </div>
</section>
