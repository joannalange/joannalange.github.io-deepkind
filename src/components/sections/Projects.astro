---
import content from '@data/content';
const { header, items } = content.projects;

const accentMap: Record<string, string> = {
  blue:     'var(--color-violet)',
  sage:     'var(--color-mint)',
  peach:    'var(--color-coral)',
  lavender: 'var(--color-rose)',
  gold:     'var(--color-gold)',
};
---

<section class="projects" id="projects" aria-label="Projekty">
  <div class="wrap">

    <header class="projects__header reveal">
      <h2 class="projects__title">{header}</h2>
    </header>

    <div class="projects__grid">
      {items.map((item, i) => (
        <article
          class="project-card reveal"
          style={`--card-accent: ${accentMap[item.accent] ?? accentMap.blue}`}
          data-reveal-delay={String(i % 2)}
        >
          <div class="project-card__image-wrap">
            <img
              src={item.image}
              alt={item.title}
              class="project-card__image"
              loading="lazy"
              width="640"
              height="400"
            />
          </div>
          <div class="project-card__body">
            <span class="project-card__subtitle">{item.subtitle}</span>
            <h3 class="project-card__title">{item.title}</h3>
            <p class="project-card__desc">{item.description}</p>
            <a href={item.url} class="project-card__cta">{item.cta}</a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
