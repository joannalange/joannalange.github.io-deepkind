---
import content from '@data/content';
const { header, subtext, options } = content.support;
---

<section id="support" aria-label="Włącz się" class="support-section">
  <div class="wrap">

    <header class="support__header reveal">
      <h2 class="support__title">{header}</h2>
      <p class="support__subtext">{subtext}</p>
    </header>

    <div class="support__options">
      {options.map((option, i) => (
        <a href={option.url}
           class={`support-option support-option--${option.theme} reveal${i > 0 ? ' reveal-delay-2' : ''}`}>
          <div class="support-option__line" aria-hidden="true"></div>
          <div class="support-option__body">
            <h3 class="support-option__title">{option.title}</h3>
            <p class="support-option__desc">{option.description}</p>
          </div>
          <span class="support-option__cta">{option.cta} →</span>
        </a>
      ))}
    </div>

  </div>
</section>
