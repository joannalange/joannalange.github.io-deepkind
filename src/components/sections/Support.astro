---
import content from '@data/content';
const { intro, options } = content.getInvolved;
---

<section id="join" aria-label="Włącz się" class="get-involved">
  <div class="wrap">

    <header class="gi__header reveal">
      <h2 class="gi__title">Włącz się</h2>
      <p class="gi__intro">{intro}</p>
    </header>

    <div class="gi__options">
      {options.map((option, i) => (
        <div class={`gi-card gi-card--${option.theme} reveal`} data-reveal-delay={String(i)}>
          <div class="gi-card__body">
            <h3 class="gi-card__title">{option.title}</h3>
            <p class="gi-card__desc">{option.description}</p>
          </div>
          <a href={option.url} class="gi-card__cta">{option.cta}</a>
        </div>
      ))}
    </div>

  </div>
</section>
