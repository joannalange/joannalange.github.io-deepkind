---
import BentoCard from '@ui/BentoCard.astro';
import content from '@data/content.json';
const { header, protocol, areas } = content.bento;

// Map each area id to its new accent color
const accentMap: Record<string, 'violet' | 'mint' | 'coral' | 'gold' | 'rose'> = {
  tech:    'violet',
  nature:  'mint',
  neuro:   'coral',
  agency:  'gold',
  empathy: 'rose',
};
---

<section class="areas" id="bento" aria-label="Obszary działań">
  <div class="wrap">

    <header class="areas__header reveal">
      <span class="s-label s-label--light">{protocol}</span>
      <h2 class="areas__title">{header}</h2>
    </header>

    <div class="areas__grid">
      {areas.map((area, i) => (
        <BentoCard
          id={area.id}
          tag={area.tag}
          title={area.title}
          description={area.description}
          variant={area.variant as 'wide' | 'standard' | 'lead'}
          accent={accentMap[area.id] ?? 'violet'}
          index={i}
          revealDelay={Math.min(i + 1, 4)}
        />
      ))}
    </div>

  </div>
</section>
