---
import BentoCard from '@ui/BentoCard.astro';
import content from '@data/content';
const { header, protocol, areas } = content.bento;
---

<section class="areas" id="bento" aria-label="Obszary działań">
  <div class="wrap">

    <header class="areas__header reveal">
      <span class="s-label s-label--light">{protocol}</span>
      <h2 class="areas__title">{header}</h2>
    </header>

    <div class="areas__grid">
      {areas.map((area, i) => (
        <BentoCard
          id={area.id}
          tag={area.tag}
          title={area.title}
          description={area.description}
          variant={area.variant}
          accent={area.accent}
          index={i}
          revealDelay={Math.min(i + 1, 4)}
        />
      ))}
    </div>

  </div>
</section>
