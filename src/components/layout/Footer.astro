---
import content from '@data/content';
const { description, tagline, org, legal, connect, copyright } = content.footer;
const email = connect.find(l => l.url.startsWith('mailto:'));
const socials = connect.filter(l => !l.url.startsWith('mailto:'));
---

<footer class="footer">
  <div class="wrap">

    <div class="footer__top">

      <!-- Brand -->
      <div class="footer__brand">
        <img src="/assets/logo.svg" alt="DeepKind" class="footer__logo-img" width="140" height="28" />
        <p class="footer__tagline">{tagline}</p>
        <p class="footer__desc">{description}</p>
      </div>

      <!-- Org info -->
      <div>
        <p class="footer__col-heading">Organizacja</p>
        <ul class="footer__org-info">
          <li>{org.name}</li>
          <li>{org.city}</li>
          <li>NIP: {org.nip}</li>
          <li>KRS: {org.krs}</li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="footer__col-heading">Prawne</p>
        <ul class="footer__links">
          {legal.map(item => (
            <li><a href={item.url} class="footer__link">{item.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <p class="footer__col-heading">Kontakt</p>
        <ul class="footer__links">
          {email && (
            <li><a href={email.url} class="footer__link">{email.url.replace('mailto:','')}</a></li>
          )}
          {socials.map(item => (
            <li>
              <a
                href={item.url}
                class="footer__link"
                target={item.url.startsWith('http') ? '_blank' : undefined}
                rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              >{item.name}</a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="footer__rainbow" aria-hidden="true"></div>

    <div class="footer__bottom">
      <p class="footer__copy">{copyright}</p>
    </div>

  </div>
</footer>
